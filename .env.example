# ─────────────────────────────────────────────────────────────────────────────
# Adapter Sign — variáveis de ambiente (EXEMPLO; valores fictícios)
# Copie para .env e substitua TODOS os valores. Nunca versione o .env.
# Gere segredos com:  openssl rand -base64 48   (ENCRYPTION_KEY: openssl rand -base64 32)
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
LOG_LEVEL=info

# Domínios públicos (sem barra final). A API também é servida em app.dominio/api via proxy.
APP_PUBLIC_URL=https://app.exemplo.com.br
API_PUBLIC_URL=https://api.exemplo.com.br
# Origens adicionais autorizadas (CORS/CSRF), separadas por vírgula. Opcional.
CORS_ORIGINS=
# Número de proxies reversos confiáveis à frente da API (Nginx/Traefik = 1).
TRUST_PROXY_HOPS=1
SWAGGER_ENABLED=true

# ── PostgreSQL (serviço "postgres" do docker-compose) ──
POSTGRES_DB=adaptersign
POSTGRES_USER=adaptersign
POSTGRES_PASSWORD=troque-esta-senha-do-banco
DATABASE_URL=postgresql://adaptersign:troque-esta-senha-do-banco@postgres:5432/adaptersign?schema=public

# ── Redis (filas BullMQ + rate limiting) ──
REDIS_PASSWORD=troque-esta-senha-do-redis
REDIS_URL=redis://:troque-esta-senha-do-redis@redis:6379/0

# ── Autenticação ──
JWT_ACCESS_SECRET=substitua-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Domínio dos cookies (deixe vazio para usar o host do app).
COOKIE_DOMAIN=
COOKIE_SECURE=true

# ── Criptografia de dados (32 bytes base64) e pepper de hashes ──
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
TOKEN_HASH_SECRET=substitua-por-outro-segredo-aleatorio-com-32-caracteres-ou-mais

# ── Armazenamento S3-compatible (bucket PRIVADO) ──
# Cloudflare R2: STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  STORAGE_REGION=auto
# Amazon S3:     deixe STORAGE_ENDPOINT vazio e defina STORAGE_REGION (ex.: sa-east-1)
# MinIO (local): STORAGE_ENDPOINT=http://minio:9000  STORAGE_FORCE_PATH_STYLE=true
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=auto
STORAGE_BUCKET=adaptersign-documents
STORAGE_ACCESS_KEY_ID=exemplo-access-key
STORAGE_SECRET_ACCESS_KEY=exemplo-secret-key
STORAGE_FORCE_PATH_STYLE=true
# Credenciais do MinIO local (somente perfil "local" do docker-compose)
MINIO_ROOT_USER=exemplo-access-key
MINIO_ROOT_PASSWORD=exemplo-secret-key

UPLOAD_MAX_BYTES=20971520
SIGNATURE_IMAGE_MAX_BYTES=307200

# ── E-mail (SMTP) — Amazon SES SMTP, Resend SMTP ou servidor próprio ──
# Perfil "local": Mailpit em mailpit:1025 (interface em http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Adapter Sign <nao-responda@exemplo.com.br>"

# ── Assinatura / OTP ──
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
SIGNER_LINK_TTL_DAYS=30
SIGNATURE_SESSION_TTL_MINUTES=60
REMINDER_MAX_COUNT=3

# ── Planos / relatórios ──
DEFAULT_PLAN_CODE=FREE
REPORT_TIMEZONE=America/Sao_Paulo

# ── Webhooks ──
WEBHOOK_ALLOW_PRIVATE_TARGETS=false
WEBHOOK_TIMEOUT_MS=10000

# ── Feature flags (não habilitam métodos sem integração real) ──
FEATURE_SMS_AUTH=false
FEATURE_WHATSAPP_AUTH=false
FEATURE_ICP_BRASIL=false
FEATURE_BIOMETRICS=false
FEATURE_WHITE_LABEL=false

# ── Branding centralizado ──
BRAND_NAME="Adapter Sign"
BRAND_PRIMARY_COLOR=#1F4FD1
BRAND_SUPPORT_EMAIL=suporte@exemplo.com.br
VALIDATION_CODE_PREFIX=ADP
# Frontend (embutido no build do Next.js)
NEXT_PUBLIC_BRAND_NAME="Adapter Sign"

# ── Somente desenvolvimento (seed) ──
SEED_USER_PASSWORD=

{
  "name": "adapter-sign",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma SaaS de assinatura eletrônica de documentos",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
